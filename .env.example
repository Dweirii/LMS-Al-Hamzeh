# ==============================================================================
# Al-Hamzeh LMS — environment variables
# ==============================================================================
# Copy to .env for local development:   cp .env.example .env
# For production, set these in your host's dashboard (Vercel: Project Settings →
# Environment Variables). Never commit a filled-in .env.
#
# Every variable below is REQUIRED. The app validates them at startup in
# lib/env.ts and refuses to boot if any is missing or malformed.
# ==============================================================================

# ------------------------------------------------------------------------------
# DATABASE — PostgreSQL
# ------------------------------------------------------------------------------
# Any Postgres instance. Managed options: Neon, Supabase, Railway, AWS RDS.
# Most hosted providers require SSL; append ?sslmode=require if so.
DATABASE_URL="postgresql://user:password@localhost:5432/lms_alhamzeh"

# ------------------------------------------------------------------------------
# AUTHENTICATION — better-auth
# ------------------------------------------------------------------------------
# Signs session cookies. Minimum 32 characters. Generate with:
#   openssl rand -base64 32
# Use a DIFFERENT value in production than in development.
BETTER_AUTH_SECRET="replace-with-a-random-32-character-secret"

# The full origin the app is served from, no trailing slash. This must match the
# real URL exactly — better-auth rejects requests from any other origin, and the
# failure surfaces in the UI only as a generic "Error sending email".
#   local:      http://localhost:3000
#   production: https://your-domain.com
BETTER_AUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# GITHUB OAUTH — "Sign in with GitHub"
# ------------------------------------------------------------------------------
# Create at: https://github.com/settings/developers → New OAuth App
# Authorization callback URL must be exactly:
#   <BETTER_AUTH_URL>/api/auth/callback/github
# Register a separate OAuth app for production; one app has one callback URL.
AUTH_GITHUB_ID="your-github-oauth-client-id"
AUTH_GITHUB_SECRET="your-github-oauth-client-secret"

# ------------------------------------------------------------------------------
# EMAIL — Resend (sign-in one-time passwords)
# ------------------------------------------------------------------------------
# API key from: https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key"

# The From address for sign-in emails. It MUST be on a domain you have verified
# at https://resend.com/domains.
#
# Resend's shared onboarding@resend.dev address only delivers to the Resend
# account owner. Leaving it in production means nobody else can ever receive a
# sign-in code, and Resend reports the send as successful — so this fails
# silently. Verify a domain before going live.
RESEND_FROM_EMAIL="Al-Hamzeh LMS <noreply@your-verified-domain.com>"

# ------------------------------------------------------------------------------
# SECURITY — Arcjet (rate limiting and bot protection)
# ------------------------------------------------------------------------------
# Site key from: https://app.arcjet.com
#
# An invalid key does NOT cause a visible error. Arcjet returns an ERROR decision
# and the app treats it as "allow", so rate limiting and bot protection are
# silently disabled. After deploying, check the Arcjet dashboard shows traffic.
ARCJET_KEY="ajkey_your_arcjet_key"

# ------------------------------------------------------------------------------
# STORAGE — Tigris (S3-compatible) for course images, videos and PDFs
# ------------------------------------------------------------------------------
# Create a bucket at https://console.tigris.dev, then generate an access key.
# Any S3-compatible provider works; adjust the endpoint accordingly.
AWS_ACCESS_KEY_ID="your-storage-access-key"
AWS_SECRET_ACCESS_KEY="your-storage-secret-key"
AWS_ENDPOINT_URL_S3="https://fly.storage.tigris.dev"
AWS_REGION="auto"

# Bucket name. This is exposed to the browser, so the bucket must allow public
# reads for images, and CORS must permit PUT from your domain for uploads.
#
# IMPORTANT: changing this also requires updating the hostname in
# next.config.ts, which allowlists the image host for next/image. Images will
# silently fail to load otherwise.
NEXT_PUBLIC_S3_BUCKET_NAME_IMAGES="your-bucket-name"

# ------------------------------------------------------------------------------
# PAYMENTS — Stripe
# ------------------------------------------------------------------------------
# Secret key from: https://dashboard.stripe.com/apikeys
# Use sk_test_... while testing and sk_live_... in production.
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"

# Webhook signing secret from: https://dashboard.stripe.com/webhooks
# Add an endpoint pointing at:  <BETTER_AUTH_URL>/api/webhook/stripe
# subscribed to the `checkout.session.completed` event, then copy its secret.
#
# Each endpoint has its own secret, so local (Stripe CLI) and production differ.
# Without a correct secret every webhook is rejected and paid enrollments stay
# stuck in Pending — the customer is charged but gets no access.
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_signing_secret"

# ------------------------------------------------------------------------------
# BUILD (optional)
# ------------------------------------------------------------------------------
# Set to "true" to skip validation during a build that has no secrets available,
# such as a Docker image build. Never set it at runtime.
# SKIP_ENV_VALIDATION="true"
